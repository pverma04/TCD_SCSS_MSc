<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="commutewalk-task2" name="Open weather data to Firebase"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="provider" value="MET EIREANN - EXTERNAL OPEN-DATA PROVIDER&lt;br&gt;Dublin Airport observations: hourly source measurements&lt;br&gt;https://prodapi.met.ie/observations/dublin/today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EA;strokeColor=#C3A66B;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="100" width="1320" height="120" /></mxCell><mxCell id="phone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#9FB8C9;fontColor=#17364A;fontSize=16;spacing=12;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="280" width="720" height="530" /></mxCell><mxCell id="cloud" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7F4;strokeColor=#9ABBAA;fontColor=#17364A;fontSize=16;spacing=12;connectable=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="280" width="550" height="530" /></mxCell><mxCell id="collector" value="Weather collector&lt;br&gt;Checks API every 60 seconds&lt;br&gt;While app is open and online&lt;br&gt;Receives current-day JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#397CA5;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="75" y="355" width="255" height="125" /></mxCell><mxCell id="parser" value="Parse and normalize&lt;br&gt;Convert valid local times to UTC&lt;br&gt;Retain raw fields + source / licence&lt;br&gt;observedAt and fetchedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#397CA5;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="395" y="355" width="325" height="125" /></mxCell><mxCell id="sqlite" value="SQLite + deduplication&lt;br&gt;One record per observation time&lt;br&gt;Durable upload queue&lt;br&gt;Retain pending records offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#397CA5;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="395" y="565" width="325" height="125" /></mxCell><mxCell id="uploader" value="HTTPS uploader&lt;br&gt;Checks queue about every second&lt;br&gt;Firebase ID token&lt;br&gt;Retry until acknowledged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#397CA5;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="75" y="565" width="255" height="125" /></mxCell><mxCell id="auth" value="Firebase Authentication&lt;br&gt;Email/password sign-in&lt;br&gt;Issues Firebase ID tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49846A;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="875" y="345" width="420" height="90" /></mxCell><mxCell id="rules" value="Realtime Database security rules&lt;br&gt;Require authenticated ownership&lt;br&gt;auth.uid matches users/&amp;lt;uid&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49846A;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="875" y="490" width="420" height="90" /></mxCell><mxCell id="db" value="Firebase Realtime Database - JSON&lt;br&gt;users/&amp;lt;uid&amp;gt;/weather/dublin-airport&lt;br&gt;observations/&amp;lt;observation-timestamp&amp;gt;&lt;br&gt;Server receipt time: uploadedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49846A;fontColor=#17364A;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="875" y="645" width="420" height="115" /></mxCell><mxCell id="e0" v